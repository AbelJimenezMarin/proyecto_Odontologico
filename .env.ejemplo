# Copie este archivo como ".env" (sin la palabra "ejemplo") y escriba sus datos reales.
#El archivo ".env" esta en .gitignore: no se sube a GitHub.

DJANGO_CLAVE_SECRETA=cambiar-esta-calve-por-una-aleatoria-y-larga
DJANGO_DEBUG=True
DJANGO_HOSTS_PERMITIDOS=localhost, 127.0.0.1

#Base de datos SQL Server
BD_MOTOR=sqlserver
BD_NOMBRE=BD_NADINNE
BD_SERVIDOR=localhost
#Con autenticación de Windows, BD_USUARIO y BD_CLAVE se dejan VACIOES.
#Solo si usa un usuario de SQL Server, escriba aqui su usurio y su clave.
BD_USUARIO=
BD_CLAVE=
BD_DRIVER=ODBC Driver 18 for SQL Server

#Correo (recordatorios). En desarrollo los correos se muestran en la consola.
CORREO_SERVIDOR=
CORREO_USUARIO=
CORREO_CLAVE=